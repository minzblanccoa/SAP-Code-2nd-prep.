<mvc:View controllerName="code2.cl2.code2.cl2.b2114.controller.TableView2"
    xmlns:t="sap.ui.table"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:u="sap.ui.unified"
    xmlns:c="sap.ui.core"
    xmlns="sap.m"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:layout="sap.ui.layout"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data">

    <Page   id="page"
            title="{i18n>title}"
            showHeader="false"
            enableScrolling="true"
            class="sapUiContentPadding">

           <t:Table rows = "{/airSet}"
                    selectionMode="Single"
                    paste="onPaste"
                    ariaLabelledBy="title"
                    visibleRowCount = "5">

                <t:extension>
                    <OverflowToolbar style="Clear">
                        <Title id = "title" text = "Airlines"/>
                    </OverflowToolbar>
                </t:extension>

                <t:columns>
                    <t:Column width="5rem" hAlign="Center">
                        <Label text = "Airline" />
                            <t:template>
                                <Text text = "{Carrid}" />
                            </t:template>
                    </t:Column>

                    <t:Column width="20rem" hAlign="Left">
                        <Label text = "Airline name" />
                            <t:template>
                                <Text text = "{Carrname}" />
                            </t:template>
                    </t:Column>
                
                    <t:Column width="20rem" hAlign="Right">
                        <Label text = "Air Fair" />
                            <t:template>
                                <Text text="{
                                    parts: [{path:'Price'},{path: 'Curkey'}],
                                    type: 'sap.ui.model.type.Currency',
                                    formatOptions: {showMeasure:true}
                                }" wrapping="false"/>
                            </t:template>
                    </t:Column>
                
                    <t:Column width="5rem" hAlign="Center">
                        <Label text = "Currency" />
                            <t:template>
                                <Text text = "{Curkey}" />
                            </t:template>
                    </t:Column>
                </t:columns>

           </t:Table>


        <!-- Creating Chart -->
        <Panel headerText="Hit rate chart by team" class = "sapUiResponsiveMargin">
        <!-- 패널에서 먼저 width랑 height 주지 마. 다 완성하고 주자. -->

            <viz:VizFrame id = "idVizFrame" uiConfig="{applicationSet:'fiori'}" vizType="line" vizProperties="{ title: {text : 'Team hit rate', visible : true} }">

                <viz:dataset>
                
                        <viz.data:FlattenedDataset data = "{hitRate>/BsTeam}">

                            <viz.data:dimensions>
                                <viz.data:DimensionDefinition name = "Team" value = "{hitRate>Team}" />
                            </viz.data:dimensions>

                            <viz.data:measures>
                                <viz.data:MeasureDefinition name = "Hitting" value = "{hitRate>Hit}" />
                            </viz.data:measures>
                        
                        </viz.data:FlattenedDataset>               

                </viz:dataset>

                <viz:feeds>
                    <viz.feeds:FeedItem id = 'valueAxisFeed'
                                        uid = "valueAxis"
                                        type = "Measure"
                                        values = "Hitting" />

                    <viz.feeds:FeedItem id = 'categoryAxisFeed'
                                        uid = "categoryAxis"
                                        type = "Dimension"
                                        values = "Team"/>
                </viz:feeds>
            
            </viz:VizFrame>
        
        </Panel>

    </Page>

</mvc:View>
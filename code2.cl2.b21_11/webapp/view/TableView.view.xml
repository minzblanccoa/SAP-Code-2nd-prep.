<mvc:View controllerName="jsontable.code2.cl2.b2111.controller.TableView"
    xmlns:t = "sap.ui.table"
    xmlns:mvc = "sap.ui.core.mvc"
    xmlns:u = "sap.ui.unified"
	xmlns:c = "sap.ui.core"
    xmlns = "sap.m">
    <Page id = "page" title = "Grid Table 연습" >
        <VBox>
            <Panel headerText="Airline" width = "40rem" class = "sapUiResponsiveMagin">
                <t:Table    rows="{/AirlineSet}"
                            selectionMode="Single"
                            paste="onPaste"
                            ariaLabelledBy="title">

                    <t:extension>
                        <OverflowToolbar style = "Clear">
						    <Title id = "title" text = "Airlines"/> <!-- title의 property -->
					    </OverflowToolbar>
                    </t:extension>

                    <t:columns>
                        <t:Column width = "15rem">
                            <Label text = "Airlines"/>
                            <t:template>
                                <Text text = "{Carrid}"/>
                            </t:template>
                        </t:Column>
                    </t:columns>

                    <t:columns>
                        <t:Column width = "15rem">
                            <Label text = "Name"/>
                            <t:template>
                                <Text text = "{Name}"/>
                            </t:template>
                        </t:Column>
                    </t:columns>

                    <t:columns>
                        <t:Column width = "15rem">
                            <Label text = "Country"/>
                            <t:template>
                                <Text text = "{Country}"/>
                            </t:template>
                        </t:Column>
                    </t:columns>

                    <t:columns>
                        <t:Column>
                            <t:template>
                                <Input value = "" width = "15rem" />
                            </t:template>
                        </t:Column>
                    </t:columns>

                </t:Table>
            </Panel>    
        </VBox>
    </Page>
</mvc:View>